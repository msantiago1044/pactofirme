# ---- Frontend (Vite) ----
# URL y clave anónima de tu proyecto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica

# ---- Backend (Serverless Functions en Vercel) ----
# Clave de servicio de Supabase — NUNCA la expongas en el frontend.
# Se usa solo en /api/verify-kyc.js y /api/cleanup-kyc-image.js para
# subir/borrar imágenes del bucket temporal kyc-temp.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-clave-de-servicio-secreta

# API Key de ZhipuAI (GLM-4V) para el OCR de cédulas.
ZHIPUAI_API_KEY=tu-api-key-de-zhipuai

# API Key de Resend para el envío de correos con el PDF adjunto.
RESEND_API_KEY=tu-api-key-de-resend
